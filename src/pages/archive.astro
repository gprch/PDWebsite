---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout title="Archive" active="archive">
  <section class="section">
    <div class="section-header"><h2>Archive</h2></div>
    {posts.map(post => (
      <a href={`/posts/${post.slug}`} class="brief-item" style="border-bottom:2px solid var(--ink)">
        <span class="brief-tag">{post.data.tag} · {post.data.date.toLocaleDateString('en-GB')}</span>
        <span class="brief-title" style="font-size:18px">{post.data.title}</span>
      </a>
    ))}
  </section>
</Layout>
